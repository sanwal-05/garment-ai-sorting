# Copy to .env in the repo root (or /backend) before running.

# Required for /admin API routes.
ADMIN_TOKEN=change-me-to-a-long-random-string

# 1 = random scores (no TensorFlow / no .keras file required)
MOCK_MODEL=1

# Optional. Defaults to sqlite:///backend/returns.db
# DATABASE_URL=sqlite:///backend/returns.db

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
